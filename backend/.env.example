# Twilio account
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_KEY_SECRET=your-api-key-secret

# Voice
TWILIO_TWIML_APP_SID=AP00000000000000000000000000000000
TWILIO_CALLER_ID=+81xxxxxxxxxx

# Conversation Orchestrator + Intelligence (setup-ci.ts が自動で埋める)
TWILIO_MEMORY_STORE_ID=
TWILIO_CONVERSATION_CONFIG_ID=
TWILIO_INTELLIGENCE_CONFIG_ID=
TWILIO_OPERATOR_CALLER_PROFILE_ID=
TWILIO_OPERATOR_TALKLIST_ID=
TWILIO_OPERATOR_CALL_SUMMARY_ID=
TWILIO_OPERATOR_SENTIMENT_ID=

# Public base URL (ngrok HTTPS)
# NGROK_AUTHTOKEN があれば backend 起動時に自動でトンネルを張り PUBLIC_BASE_URL を上書きする
# (dashboard.ngrok.com からトークン取得)
NGROK_AUTHTOKEN=
# 有料 reserved domain を使う場合のみ設定 (例: my-demo.ngrok.io)
NGROK_DOMAIN=
# 手動 ngrok / 静的 URL を使う場合はここに貼る (NGROK_AUTHTOKEN 未設定時のフォールバック)
PUBLIC_BASE_URL=

# Server
PORT=4000
LOG_LEVEL=info

# ASR (UI 用の transcript ticker で使う <Start><Transcription>)
# Runtime は Setup 画面から切替可 (POST /api/transcription/config)。ここは default
TRANSCRIPTION_LANGUAGE=ja-JP
# Engine 候補: google | deepgram
# 日本語で精度が物足りない場合は deepgram + nova-3-general に切替を推奨
TRANSCRIPTION_ENGINE=google
# speechModel:
#   google なら "long" (hints 併用可、日本語推奨) / "telephony" (低遅延だが hints 非対応) / "short"
#   deepgram なら "nova-3-general" / "nova-2"
TRANSCRIPTION_SPEECH_MODEL=long
# 追加の hints (ドメイン語彙、comma-separated)。既定の 100+ 語 (transcriptionHints.ts) にマージ
TRANSCRIPTION_HINTS_EXTRA=
# hints を完全に無効化したい場合のみ true (通常は空/false)
# TRANSCRIPTION_HINTS_DISABLE=false
